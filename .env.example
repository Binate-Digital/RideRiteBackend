# Server
PORT=4000
NODE_ENV=development
APP_NAME=RideRite
APP_URL=http://localhost:4000
# Frontend origin used in verification / password-reset email links
WEB_APP_URL=http://localhost:8080
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,https://riderite-admin.deployment-uat.com

# MongoDB (local default)
MONGODB_URI=mongodb://127.0.0.1:27017/riderite

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Tokens for email verify / password reset (hours)
EMAIL_VERIFY_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1

# In development, verification & reset tokens are returned in API JSON
# so you can test from Postman without a real mailbox.
EXPOSE_DEV_TOKENS=true

# Stripe payments
# Leave STRIPE_SECRET_KEY empty (or STRIPE_MOCK=true) for local mock payments.
# For real Stripe test mode: set sk_test_... / pk_test_... and STRIPE_MOCK=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK=false

# QA helpers (driver "Simulate drive") for all accounts. Seeded @riderite.test accounts always get them.
ENABLE_TEST_TOOLS=false

# Ride dispatch (sequential offers, nearest driver first)
# Seconds a driver has to accept an offer before it moves to the next nearest driver
DISPATCH_OFFER_SECONDS=30
# Minutes before an unaccepted request is marked "no drivers available"
DISPATCH_MAX_MINUTES=5
# How often the background sweeper advances expired offers (survives restarts)
DISPATCH_SWEEP_SECONDS=5
# Card ride that found no driver: seconds to wait before refunding it (0 = refund immediately).
# During the delay the rider can re-request and reuse the payment.
NO_DRIVERS_REFUND_DELAY_SECONDS=0

# Payments (Phase 2)
# Platform commission on a ride's base fare (meter + booking fee, excl. service fee & tax). Driver gets the rest.
PLATFORM_COMMISSION_RATE=0.20
# Platform commission on peer-to-peer rental subtotals (fleet rentals are 100% platform revenue)
RENTAL_COMMISSION_RATE=0.15
# Seconds an unpaid rental / chauffeur booking holds its dates before it is released
BOOKING_HOLD_SECONDS=900
# How often the payments sweeper releases expired holds and retries pending refunds
PAYMENT_SWEEP_SECONDS=30
# Private driver (chauffeur) hourly rates in cents, by vehicle type, and minimum booking notice
CHAUFFEUR_HOURLY_SEDAN_CENTS=6500
CHAUFFEUR_HOURLY_SUV_CENTS=8500
CHAUFFEUR_HOURLY_TRUCK_CENTS=9500
CHAUFFEUR_MIN_LEAD_MINUTES=60
# Driver subscription Stripe Price ids. Leave empty to find/create prices by lookup_key
# (riderite_driver_monthly = $100/month, riderite_driver_weekly = $32/week).
STRIPE_PRICE_DRIVER_MONTHLY=
STRIPE_PRICE_DRIVER_WEEKLY=
# Stripe webhook events to enable: payment_intent.succeeded, payment_intent.payment_failed,
# invoice.paid, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted

# SMTP for receipts / verification emails. Leave SMTP_HOST empty to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RideRite <no-reply@example.com>"

# ---------- Phase 3: rider features ----------
# Google Sign-In (the only social login): OAuth 2.0 *Web application* client ID from Google Cloud
# Console → APIs & Services → Credentials. Same value as the web app's VITE_GOOGLE_CLIENT_ID; add
# the web origin(s) (e.g. https://riderite.example) under "Authorized JavaScript origins".
# Comma-separate to accept several client ids. Empty → POST /api/auth/social/google answers
# 503 SOCIAL_NOT_CONFIGURED and the web app hides the button.
GOOGLE_CLIENT_ID=
# Twilio: Verify (SMS OTP) + Programmable Voice (masked rider/driver calls).
# Without Verify, phone OTP uses STATIC_SMS_OTP printed to the server console (dev only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Pool of Twilio numbers (E.164, comma-separated) that bridge masked calls. Point each number's
# "A call comes in" webhook at POST {TWILIO_WEBHOOK_BASE_URL}/api/telephony/voice.
TWILIO_PROXY_NUMBERS=
# SMS notifications (Programmable Messaging) for high-value events only (driver assigned /
# arrived, trip cancelled, chauffeur 1-hour reminder, booking confirmed, payment failed,
# membership past due) — to verified phones whose SMS channel + category are on. Set a Messaging
# Service SID (preferred, MG…) or a From number (E.164) plus TWILIO_ACCOUNT_SID / AUTH_TOKEN.
# Neither set → texts are printed to the server console instead.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
# Max notification texts per user per hour (on top of their preferences)
SMS_NOTIFY_MAX_PER_HOUR=10
# Public base URL Twilio calls (used to validate webhook signatures). Defaults to APP_URL.
TWILIO_WEBHOOK_BASE_URL=
STATIC_SMS_OTP=123456
# Per phone number: max codes per hour, seconds between resends, code lifetime (minutes)
SMS_OTP_MAX_PER_HOUR=5
SMS_OTP_RESEND_SECONDS=30
SMS_OTP_TTL_MINUTES=10
# Paid cancellations: full refund at least N hours before the start, else this % of the amount paid
RENTAL_FULL_REFUND_HOURS=24
RENTAL_LATE_CANCEL_REFUND_PERCENT=50
CHAUFFEUR_FULL_REFUND_HOURS=24
CHAUFFEUR_LATE_CANCEL_REFUND_PERCENT=50
# Platform share of a chauffeur booking; the assigned driver earns the rest when it completes
CHAUFFEUR_COMMISSION_RATE=0.20
# Assigned chauffeur may start the booking this many minutes before its start time
CHAUFFEUR_START_EARLY_MINUTES=30
# Booking reminders (rentals + chauffeur): minutes before the start, and how often to check
BOOKING_REMINDER_LEADS_MINUTES=1440,60
REMINDER_SWEEP_SECONDS=60
# Trip chat stays readable this many hours after the trip ends
CHAT_HISTORY_HOURS=24
# Web push (VAPID). Generate with: npx web-push generate-vapid-keys. Empty → push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services, e.g. mailto:support@riderite.com
VAPID_SUBJECT=
# ---------- Phase 4: driver features ----------
# How often the driver housekeeping sweep runs (document expiry, bonus months, maintenance and
# membership notices). Every step is idempotent; default once a day (also ~10 s after start).
DRIVER_SWEEP_MINUTES=1440
# Driver documents (license / registration / insurance): notify this many days before expiry
# (each once). An expired document blocks going online / accepting until a new one is uploaded.
DOCUMENT_EXPIRY_NOTICE_DAYS=30,7,1
# Membership that won't renew (auto-renew cancelled → "tap Resume", or a manual / mock membership
# with no Stripe subscription → "tap Renew"): warn this many days before it ends. Auto-renewing
# Stripe memberships get no notice (Stripe charges them; "Membership renewed" is sent on payment).
SUBSCRIPTION_EXPIRY_NOTICE_DAYS=3
# Monthly bonus (TRD 5.5). On time = arrived within the pickup ETA quoted at accept + grace minutes.
BONUS_ONTIME_GRACE_MINUTES=5
BONUS_MIN_TRIPS=20
# 0..1 (0.9 = 90% of measured trips on time)
BONUS_MIN_ONTIME_RATE=0.9
# Safe-driving score 0..100 (see src/utils/bonus.js for the formula)
BONUS_MIN_SAFE_SCORE=80
# Bonus amount for an eligible month (paid with the next payout once admin approves)
BONUS_AMOUNT_CENTS=10000
# Company-covered maintenance (TRD 5.6): intervals (months) and how many days before the due
# date a covered service can be requested
MAINTENANCE_OIL_CHANGE_MONTHS=3
MAINTENANCE_INSPECTION_MONTHS=12
MAINTENANCE_REQUEST_WINDOW_DAYS=14
# P2P rentals: owner may decline a paid booking (full refund) within this many hours of it being made
RENTAL_OWNER_DECLINE_HOURS=12
# An approved listing whose daily price moves more than this % from the approved price goes back to review
RENTAL_PRICE_REVIEW_CHANGE_PERCENT=50
# ---------- Phase 5: admin panel ----------
# Fares, cancellation fee rules, commissions, chauffeur rates, bonus thresholds and the dispatch
# offer window are edited in the admin panel (Settings collection). The env values above stay the
# defaults; other API instances pick up admin changes within this many seconds.
SETTINGS_REFRESH_SECONDS=30
# Request-latency window for the admin health page (per API instance, in memory)
METRICS_WINDOW_MINUTES=15
METRICS_MAX_SAMPLES=50000
# Live admin dashboard counters are pushed at most this often (ms)
ADMIN_COUNTERS_THROTTLE_MS=1000

# ---------- Batch 1: privacy & legal ----------
# Private driver documents (license front/back, registration, insurance). All four S3_* set →
# documents go to this bucket as PRIVATE objects; the API hands the owner / admins with the
# drivers:documents permission a presigned GET URL per view (browser downloads from S3 directly).
# Bucket: block all public access; the IAM key needs s3:PutObject, s3:GetObject, s3:DeleteObject,
# s3:HeadObject (s3:ListBucket optional) on arn:aws:s3:::BUCKET/S3_DOCUMENTS_PREFIX*.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: S3-compatible storage (MinIO, Cloudflare R2, DigitalOcean Spaces…), path-style
S3_ENDPOINT=
# Key prefix for documents (default driver-documents/) and presigned URL lifetime (default 300 s)
S3_DOCUMENTS_PREFIX=driver-documents/
S3_SIGNED_URL_TTL_SECONDS=300
# S3 unset → documents are stored on this server's disk outside the public /uploads folder
# (default ./private-uploads; mount a persistent volume) and served only through short-lived
# signed links issued after the owner / admin check. Documents NEVER go to the external upload
# service (UPLOAD_API_*): its URLs are public and can't be made private, so it is kept for
# avatars and rental listing photos only. Old documents already stored there keep their URL
# until the driver re-uploads them.
PRIVATE_UPLOAD_DIR=
# Max size per driver document (MB); files must really be JPG / PNG / WEBP / PDF (magic bytes)
DOCUMENT_MAX_MB=10
# Driver location privacy: nearby-driver pins (signed-in users only) are snapped to this grid and
# rate-limited per user; shared trip links work until this many minutes after the trip ends and
# never longer than TRIP_SHARE_MAX_HOURS after they were created.
NEARBY_GRID_METERS=120
NEARBY_RATE_LIMIT_PER_MINUTE=30
TRIP_SHARE_GRACE_MINUTES=60
TRIP_SHARE_MAX_HOURS=24
